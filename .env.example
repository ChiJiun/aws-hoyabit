# ============================================================
# 環境變數範例檔
#
# 使用方式：
#   1. 本機開發：複製這個檔案為 .env，填入真實金鑰
#      （.env 已被 .gitignore 排除，不會上傳到 GitHub）
#   2. AWS Lambda：把下列變數逐一填入 Lambda 設定畫面的
#      「環境變數」區塊，不需要上傳 .env 檔案
#
# 注意：這個 .env.example 檔案「要」提交到 GitHub，
#       它的作用是告訴別人這個專案需要哪些環境變數，
#       所以裡面只放假的示範值，不要填真實金鑰。
# ============================================================

# ---- AWS 設定 ----
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=請填入你在 Bedrock Model access 頁面看到的模型 ID

# ---- S3 Bucket 名稱 ----
DATA_BUCKET=crypto-agent-data-你的隊名
FRONTEND_BUCKET=crypto-agent-web-你的隊名

# ---- 執行參數 ----
MAX_AGENT_TURNS=8
TIME_BUDGET_SECONDS=600

# ---- 外部資料 API 金鑰（需要註冊申請）----
COINGECKO_API_KEY=your_coingecko_demo_key_here
CRYPTOPANIC_API_KEY=your_cryptopanic_token_here
ETHERSCAN_API_KEY=your_etherscan_v2_key_here
HELIUS_API_KEY=your_helius_key_here
FRED_API_KEY=your_fred_key_here

# ---- 不需要金鑰的來源（列在這裡供參考，程式碼中直接寫死網址即可）----
# mempool.space        BTC 鏈上資料
# Blockscout           BNB 鏈上資料
# XRPL 公開節點         XRP 鏈上資料
# alternative.me       Fear & Greed 情緒指數
# Binance 公開 API      即時價格補齊
