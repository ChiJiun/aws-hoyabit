# ============================================================
# 環境變數範例檔
#
# 使用方式：
#   1. 本機開發：複製這個檔案為 .env，填入真實金鑰
#      （.env 已被 .gitignore 排除，不會上傳到 GitHub）
#   2. AWS Lambda：把下列變數逐一填入 Lambda 設定畫面的
#      「環境變數」區塊，不需要上傳 .env 檔案
#
# 注意：這個 .env.example 檔案「要」提交到 GitHub，
#       它的作用是告訴別人這個專案需要哪些環境變數，
#       所以裡面只放假的示範值，不要填真實金鑰。
# ============================================================

# ---- AWS 設定 ----
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_SESSION_TOKEN=your_session_token_here_if_using_temporary_credentials
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# ---- S3 Bucket 名稱（本機測試留空即走本地 fallback）----
DATA_BUCKET=crypto-agent-data-你的隊名
FRONTEND_BUCKET=crypto-agent-web-你的隊名

# ---- 執行參數 ----
MAX_AGENT_TURNS=8
TIME_BUDGET_SECONDS=600

# ---- 多階段架構時間預算（佔 TIME_BUDGET_SECONDS 的比例）----
PLANNER_BUDGET_PCT=0.05
RESEARCH_BUDGET_PCT=0.55
VALIDATION_BUDGET_PCT=0.15
SYNTHESIS_BUDGET_PCT=0.20
MAX_SUB_AGENTS=3
MAX_SUB_AGENT_TURNS=6

# ============================================================
# 外部資料 API 金鑰
# 分為「需要金鑰」和「免鑰」兩類
# 免鑰來源不需要環境變數，程式碼中直接呼叫
# ============================================================

# ---- 價格與市值（需金鑰）----
COINGECKO_API_KEY=your_coingecko_demo_key_here
CMC_API_KEY=your_coinmarketcap_key_here

# ---- 衍生品（需金鑰）----
COINGLASS_API_KEY=your_coinglass_key_here

# ---- 鏈上（需金鑰）----
ETHERSCAN_API_KEY=your_etherscan_v2_key_here
HELIUS_API_KEY=your_helius_key_here

# ---- 情緒與社群（需金鑰）----
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here

# ---- ETF 與機構（需金鑰）----
SOSOVALUE_API_KEY=your_sosovalue_key_here

# ---- 新聞與總經（需金鑰）----
FRED_API_KEY=your_fred_key_here

# ---- 選用：額度實測後決定是否啟用 ----
DUNE_API_KEY=your_dune_key_here

# ============================================================
# 免鑰來源（不需要環境變數，列在這裡供參考）
# ============================================================
# Binance Spot API       即時 OHLCV、盤口深度
# Binance Futures API    資金費率、OI、多空比
# Hyperliquid API        資金費率、OI、清算（Tier 1 主力）
# Deribit API            DVOL、期權 OI、Put/Call（BTC/ETH）
# Polymarket Gamma API   事件市場價格（創意度亮點）
# alternative.me         Fear & Greed 指數
# mempool.space          BTC 鏈上
# Blockscout             BNB 鏈上
# XRPL 公開節點           XRP 鏈上
# DefiLlama             TVL、穩定幣供給、鏈間資金流
# Google News RSS        新聞聚合
# CoinDesk/The Block RSS 媒體 RSS
# 官方部落格 + GitHub RSS  一手公告
# SEC EDGAR              監管文件
# CFTC COT 報告          機構淨部位（每週）
# 財經日曆               FOMC/CPI 排程（硬編碼）
